# =============================================================================
# Lemzakov Data Room — environment variables
# Copy to .env (local) or set these in the Vercel project settings.
# Everything here is SERVER-SIDE only. Never expose the service account key or
# OAuth secret to the browser.
# =============================================================================

# --- Storage (Redis) ---------------------------------------------------------
# Project config, sessions, ACLs, page categories and analytics — plus the
# pre-Blob back catalogue of page HTML and project files, which was deliberately
# left in place rather than migrated (see below).
# Provided by the Vercel Redis integration (redis:// or rediss://).
REDIS_URL=redis://default:password@host:6379

# --- Storage (Vercel Blob) ---------------------------------------------------
# Where page HTML and mirrored project files are written from now on. Injected
# automatically by the Vercel Blob integration; set it locally to exercise the
# Blob path in `vercel dev`.
#
# The store MUST be PRIVATE. Private blobs have no publicly reachable URL and
# are only readable through this token, so every byte keeps flowing through
# api/html.js, lib/project-serve.js and lib/asset-serve.js where the Google
# sign-in + allow-list checks live. A public store would hand out permanent
# unauthenticated URLs and silently bypass all page-level access control.
#
# With this unset the app falls back to Redis for reads AND writes, exactly as
# it behaved before the cutover — nothing breaks, it just stops using Blob.
# The ONE exception is page images (/<slug>/<name>): they have no Redis path at
# all, so uploading one without this token is refused rather than putting binary
# data in a RAM-priced store.
BLOB_READ_WRITE_TOKEN=
# Only needed when authenticating with a Vercel OIDC token instead of the
# read-write token above; the SDK otherwise resolves the store from the token.
BLOB_STORE_ID=

# --- Google Drive sync (service account — REQUIRED for private folders) -------
# A Google Cloud service account JSON key, raw JSON or base64-encoded JSON
# (base64 is safer in Vercel env vars, which mangle multi-line PEM keys):
#   base64 -w0 service-account.json
# Share each Drive folder (single-file source folder AND every project folder)
# with this service account's client_email as "Viewer".
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional fallback: an API key (only works for fully public folders; cannot
# reliably enumerate private folders). Prefer the service account above.
GOOGLE_API_KEY=

# --- Single-file publishing flow (existing) ----------------------------------
# The Drive folder that feeds the single-file pages (served at /<slug>).
# Provide the folder ID or a full Drive folder link.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_LINK=

# Secret guarding /api/sync, /api/diagnose and /secret-refresh?run=1.
SYNC_SECRET=

# --- Admin (/admin + project & page management APIs) -------------------------
# Password for the /admin dashboard (username is "admin") and bearer token for
# /api/admin/*. Falls back to SYNC_SECRET if unset.
# Also authenticates the remote MCP connector (Claude custom connector at
# /mcp): you enter this token once on the OAuth sign-in page. No separate
# config is needed to enable the connector.
ADMIN_TOKEN=

# --- Google OAuth (viewer sign-in) -------------------------------------------
# OAuth 2.0 "Web application" client. Add this authorized redirect URI in the
# Google Cloud console:  https://<your-domain>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override if the callback URL differs from the request-origin default.
GOOGLE_OAUTH_REDIRECT_URI=

# --- Scheduled project sync (Vercel Cron) ------------------------------------
# Secret for /api/projects-sync. Vercel Cron sends it as a Bearer token.
# Falls back to SYNC_SECRET if unset. The schedule lives in vercel.json
# (default: every 15 minutes) — edit it there to change the interval.
CRON_SECRET=

# --- Telegram bot (access approvals + publish alerts + admin menu) -----------
# The same bot delivers access-request approvals, sends you a notification with
# every address whenever a page is published, and exposes a private menu
# (/start, /list, /categories) to browse pages and fetch their URLs. It only
# ever responds to TELEGRAM_ADMIN_CHAT_ID — the bot is private to you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# The production build auto-registers the Telegram webhook using the vars above
# (secret always matches, no manual step). Optional overrides:
#   WEBHOOK_URL                  full webhook URL; else built from PAGE_DOMAINS[0]
#   TELEGRAM_WEBHOOK_AUTOREGISTER=0   disable the auto-registration on deploy
WEBHOOK_URL=
TELEGRAM_WEBHOOK_AUTOREGISTER=

# --- Page-open analytics -----------------------------------------------------
# Every page open is recorded server-side (who / where / device / referrer /
# time) and enriched by an injected beacon (active dwell time + scroll depth).
# Stats are visible per page in /admin. Recording is ON by default; set this to
# 1 to disable all recording, cookie-setting and the beacon injection.
ANALYTICS_DISABLED=

# --- Public page domains -----------------------------------------------------
# The hostnames a single-file page is reachable on. Used to build the address
# list in publish notifications and the Telegram menu. Comma/space separated.
# Defaults to: data.lemzakov.com, data.wize.ae
PAGE_DOMAINS=data.lemzakov.com,data.wize.ae
